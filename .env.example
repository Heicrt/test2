# ===== 切换供应商和模型 =====
# 可选供应商: anthropic, openai, deepseek, zhipu, dashscope, ollama, siliconflow, groq, custom
# 具体模型名见 providers.toml
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-xxxxx

# ===== 可选参数 =====
LLM_TEMPERATURE=0

# ===== 自定义供应商时才需要填 =====
# LLM_BASE_URL=https://your-custom-api.com/v1

# ===== 和风天气 API（使用 weather 工具时需要）=====
# 注册地址: https://console.qweather.com/home?lang=zh
QWEATHER_API_HOST=xxxxxx
QWEATHER_API_KEY=xxxxxx
